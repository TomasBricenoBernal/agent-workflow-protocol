#!/bin/sh
# Keep AGENTS.md in sync with the protocol modules, then run the project checks.
#
# AGENTS.md is generated from .agents/protocol/*.md (see
# .agents/planning/scripts/build_agents.py). This hook regenerates it before each commit
# and stages it if it changed, so the flattened protocol never drifts from the
# source modules.
#
# Enable once per clone with:  git config core.hooksPath .agents/hooks
set -e

if command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  PY=python
fi

"$PY" .agents/planning/scripts/build_agents.py >/dev/null

if ! git diff --quiet -- AGENTS.md; then
  git add AGENTS.md
  echo "pre-commit: regenerated and staged AGENTS.md"
fi

# Run the project checks (lint, tests, task docs). Prints only failures.
"$PY" .agents/planning/scripts/check.py
